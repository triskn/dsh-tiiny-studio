{
  "name": "dsh-tiiny-video",
  "version": "2.1.2",
  "description": "Tiiny Studio for DeepSeek Harness: create pictures, videos and textured 3D models on your Tiiny. Reuse one image across media and native 3D without switching models behind your back.",
  "type": "module",
  "license": "MIT",
  "author": "Tiiny",
  "homepage": "https://github.com/triskn/dsh-tiiny-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triskn/dsh-tiiny-studio.git"
  },
  "bugs": {
    "url": "https://github.com/triskn/dsh-tiiny-studio/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "tiiny",
    "video",
    "text-to-video",
    "image-to-video",
    "minimax",
    "image-to-3d",
    "hunyuan3d",
    "glb",
    "tiiny-studio"
  ],
  "engines": {
    "node": ">=20.3",
    "dsh": "^0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "workbench.js",
    "media-files.js",
    "activity.js",
    "three/*.js",
    "ui/*.part.js",
    "build-client.mjs",
    "persistence.js",
    "device.js",
    "video-api.js",
    "assets.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build:client": "node build-client.mjs",
    "check:client": "node build-client.mjs --check",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
